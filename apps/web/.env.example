# Copy to .env.local. On Vercel, set only what you want to override.

# Data source: "mock" (default until the indexer API exists: demo data in the browser, every screen
# explorable, "Connect wallet" connects a demo wallet) or "live" (Soroban contract + the indexer API).
# NEXT_PUBLIC_API_SOURCE=live

# The deployed DCA vault contract (contracts/dca-vault) on Testnet. Required in live mode.
# NEXT_PUBLIC_VAULT_CONTRACT_ID=C...

# Optional: a different Soroban RPC (defaults to https://soroban-testnet.stellar.org).
# NEXT_PUBLIC_SOROBAN_RPC_URL=

# Server only: the read API's route handlers (src/app/api/v1) query the indexer's database.
# Never expose the service role key with a NEXT_PUBLIC_ prefix.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Canonical URLs (optional) — src/lib/site.ts.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_LANDING_URL=http://localhost:3002

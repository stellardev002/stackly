# Copy to .env.local. Nothing here is required: the app talks to the live Stackly backend by default.

# The backend the same-origin proxy forwards `/api/v1/*` to (next.config.ts). Its routes sit under `/v1`.
# API_PROXY_TARGET=https://api.usestackly.app

# Or skip the proxy and call the backend directly (it must then allow this origin in CORS).
# NEXT_PUBLIC_API_URL=https://api.usestackly.app/v1

# WalletConnect (Reown) project id for the Stellar Wallets Kit — src/features/wallet/kit.ts has a default.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Serve the app at the root instead of /app on Vercel (only once it has its own domain).
# APP_BASE_PATH=

# Canonical URLs (optional) — src/lib/site.ts. Production defaults to https://usestackly.app (+ /app).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_LANDING_URL=http://localhost:3002

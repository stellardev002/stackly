# Copy to .env (read by `pnpm dev` / `pnpm start` through Node's --env-file-if-exists).

# The deployed DCA vault contract on Testnet.
VAULT_CONTRACT_ID=

# The keeper's own Testnet account. It pays fees for `execute` calls and is the only key the keeper holds.
# The contract grants it no other rights: it cannot withdraw, change strategies or redirect assets.
# Fund it with Friendbot. Never reuse a key that controls user funds.
KEEPER_SECRET_KEY=

# The indexer database (supabase/migrations). Service role: server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# KEEPER_POLL_INTERVAL_MS=30000
# KEEPER_MAX_RETRIES=3

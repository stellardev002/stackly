# Copy to .env.local. Nothing here is required: the admin talks to the live Stackly backend by default.

# The backend the same-origin proxy forwards `/api/v1/*` and `/api/health` to (next.config.ts).
# API_PROXY_TARGET=https://api.usestackly.app

# Serve the admin at the root instead of /admin on Vercel (only once it has its own domain).
# ADMIN_BASE_PATH=

# WalletConnect (Reown) project id for signing in with Varial Mobile — src/features/wallet/kit.ts has a default.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
